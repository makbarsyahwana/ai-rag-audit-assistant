{
  "family": "audit-rag-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/audit-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/audit-rag-task-role",
  "containerDefinitions": [
    {
      "name": "audit-rag-engine",
      "image": "{{IMAGE}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "LOG_FORMAT", "value": "json" }
      ],
      "secrets": [
        {
          "name": "NEO4J_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/staging/neo4j-uri"
        },
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/staging/mongodb-uri"
        },
        {
          "name": "S3_ENDPOINT",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/staging/s3-endpoint"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/openai-api-key"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/staging/redis-url"
        },
        {
          "name": "RABBITMQ_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:{{ACCOUNT_ID}}:secret:audit/staging/rabbitmq-url"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8001/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 45
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/audit-rag-staging",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "rag"
        }
      }
    }
  ]
}
